<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Crucial: Re-enable GDI+ on Unix for System.Drawing -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Suppress platform analyzer warnings for System.Drawing / Fonts -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    
  </PropertyGroup>

  <ItemGroup>
    <!-- Enables GDI+ calls on non-Windows platforms in modern .NET -->
    <RuntimeHostConfigurationOption Include="System.Drawing.EnableUnixSupport" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Core.System.Windows.Forms" Version="1.0.0-alpha7" />
  </ItemGroup>

</Project>
